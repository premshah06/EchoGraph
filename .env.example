# OpenAI API Configuration
OPENAI_API_KEY=your_openai_api_key_here

# Server Configuration
HOST=0.0.0.0
PORT=8000

# ChromaDB Configuration
CHROMADB_PERSIST_DIR=./echosystem_db

# CORS Configuration (comma-separated origins)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000

# Demo Mode (set to true to use pre-generated sample data)
DEMO_MODE=false

# API Key Authentication (comma-separated keys; leave empty to disable auth)
# When set, ingest/query/reset endpoints require an X-API-Key header matching one of these values.
API_KEYS=

# Runtime tuning
LOG_LEVEL=INFO
WORKERS=2

# Token optimization engine
# Set to false to fall back to plain LLMClient (no routing/compression/cost tracking)
ENABLE_TOKEN_OPTIMIZER=true
